{
  "name": "semantic-search",
  "version": "0.1.3",
  "description": "Semantic code search for the current project. Optional scan roots index ALL SOURCE CODE beneath those folders; cold searches can take minutes, unlike cheap cross-project NOTES scans in memory.",
  "mcpServers": {
    "semantic-search": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/decode-plugins/semantic-search/0.1.3/scripts/server.sh\""
      ],
      "env_vars": [
        "CODEX_HOME",
        "HOME",
        "PATH",
        "XDG_CACHE_HOME",
        "GH_CONFIG_DIR",
        "DECODE_PLUGINS_STANDALONE",
        "DECODE_PLUGINS_SCAN_ROOT",
        "DECODE_PLUGINS_SCAN_ROOT_2"
      ]
    }
  }
}
