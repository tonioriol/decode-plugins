{
  "name": "semantic-search",
  "version": "0.3.2",
  "description": "Semantic code search for the current project by default. Optional scan roots index ALL SOURCE CODE, unlike memory's cheap NOTES scans. Broad cold scans can take minutes and use substantial disk space.",
  "mcpServers": {
    "semantic-search": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/decode-plugins/semantic-search/0.3.2/scripts/server.sh\""
      ],
      "env_vars": [
        "CODEX_HOME",
        "HOME",
        "PATH",
        "XDG_CACHE_HOME",
        "GH_CONFIG_DIR",
        "DECODE_PLUGINS_SCAN_ROOT",
        "DECODE_PLUGINS_SCAN_ROOT_2",
        "DECODE_PLUGINS_DATA",
        "TMPDIR",
        "XDG_CONFIG_HOME"
      ],
      "enabled": true,
      "enabled_tools": [
        "project_search"
      ],
      "default_tools_approval_mode": "approve"
    }
  }
}
