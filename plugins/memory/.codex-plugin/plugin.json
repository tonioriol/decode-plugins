{
  "name": "memory",
  "version": "0.1.2",
  "description": "Durable project notes, recall, and lifecycle reminders.",
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/decode-plugins/memory/0.1.2/scripts/server.sh\""
      ],
      "env_vars": [
        "CODEX_HOME",
        "HOME",
        "PATH",
        "XDG_CACHE_HOME",
        "GH_CONFIG_DIR",
        "DECODE_PLUGINS_STANDALONE",
        "DECODE_PLUGINS_SCAN_ROOT",
        "DECODE_PLUGINS_SCAN_ROOT_2"
      ]
    }
  },
  "skills": "./skills",
  "hooks": "./hooks/codex.json"
}
