{
  "name": "memory",
  "version": "0.2.0",
  "description": "Durable project notes, recall, and lifecycle reminders. Optional scan roots perform cheap cross-project NOTES scans (memory/ and docs/ only), not source-code indexing.",
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/decode-plugins/memory/0.2.0/scripts/server.sh\""
      ],
      "env_vars": [
        "CODEX_HOME",
        "HOME",
        "PATH",
        "XDG_CACHE_HOME",
        "GH_CONFIG_DIR",
        "DECODE_PLUGINS_STANDALONE",
        "DECODE_PLUGINS_SCAN_ROOT",
        "DECODE_PLUGINS_SCAN_ROOT_2"
      ],
      "enabled": true,
      "enabled_tools": [
        "search"
      ],
      "default_tools_approval_mode": "approve"
    },
    "chats": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec env DECODE_PLUGINS_HARNESS=codex \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/decode-plugins/memory/0.2.0/scripts/chats-server.sh\""
      ],
      "env_vars": [
        "CODEX_HOME",
        "HOME",
        "PATH",
        "XDG_CACHE_HOME",
        "GH_CONFIG_DIR",
        "DECODE_PLUGINS_STANDALONE",
        "XDG_CONFIG_HOME",
        "DECODE_PLUGINS_INDEX_CHATS"
      ],
      "enabled": true,
      "enabled_tools": [
        "search_chats"
      ],
      "default_tools_approval_mode": "approve"
    }
  },
  "skills": "./skills",
  "hooks": "./hooks/codex.json"
}
